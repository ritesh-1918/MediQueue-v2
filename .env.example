# =============================================================================
# MediQueue v2 — Environment Variable Reference
# Copy this file to .env.local and fill in your values.
# NEVER put real secrets in this file — it is committed to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase
# Dashboard → Project Settings → API
# -----------------------------------------------------------------------------

# Your Supabase project URL (safe to expose — used in browser and server)
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co

# Anon/public key — safe to expose, RLS enforces access control
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Service role key — NEVER expose client-side. Used only in API routes
# to bypass RLS for trusted server operations (queue management, admin).
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# -----------------------------------------------------------------------------
# AI — Free-tier fallback chain (9 slots, tried in order)
# The route tries each key in sequence; skips to next on 429 or any error.
# You only need ONE working key for the feature to function.
# -----------------------------------------------------------------------------

# Gemini 1.5 Flash (slots 1-3) — aistudio.google.com/app/apikey
# Free tier: 15 RPM / 1M tokens/day per key. Add up to 3 keys for headroom.
GEMINI_API_KEY_1=AIza...
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# OpenRouter — mistralai/mistral-7b-instruct:free (slots 4-6)
# openrouter.ai/keys — free model, no credit card required.
OPENROUTER_API_KEY_1=sk-or-v1-...
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=

# Groq — llama3-8b-8192 (slots 7-8) — console.groq.com/keys
# Free tier: 30 RPM / 14,400 RPD per key.
GROQ_API_KEY_1=gsk_...
GROQ_API_KEY_2=

# Hugging Face — Mistral-7B-Instruct-v0.2 (slot 9, last resort)
# huggingface.co/settings/tokens — free inference API, slowest of the chain.
HUGGINGFACE_API_KEY=hf_...

# -----------------------------------------------------------------------------
# Stripe
# dashboard.stripe.com → Developers → API Keys
# -----------------------------------------------------------------------------

# Secret key — server-side only (API routes). Never expose to the browser.
STRIPE_SECRET_KEY=sk_live_...

# Publishable key — safe to expose in the browser.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# Webhook signing secret — used to verify Stripe events in /api/webhooks/stripe
# Dashboard → Developers → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# -----------------------------------------------------------------------------
# PostHog
# app.posthog.com → Project Settings → Project API Key
# -----------------------------------------------------------------------------

# Project API key — safe to expose (PostHog is a client-side analytics tool)
NEXT_PUBLIC_POSTHOG_KEY=phc_...

# PostHog ingestion host. Use https://app.posthog.com (US) or
# https://eu.posthog.com (EU) depending on your data residency requirements.
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# -----------------------------------------------------------------------------
# Sentry
# sentry.io → Project → Settings → Client Keys (DSN)
# -----------------------------------------------------------------------------

# Data Source Name — identifies your Sentry project. Safe to expose.
SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project-id>
